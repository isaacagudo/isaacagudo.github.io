  "summary": "Associate Professor of Computer Science at the University of Málaga, researching applied cryptography at NICS Lab, and founder of Decentralized Security.",
  "lede": "I teach and research applied cryptography at the University of Málaga, where I am an Associate Professor in the Department of Computer Science and a member of NICS Lab. I am also the founder of Decentralized Security.",
  "research": [
    {
      "name": "Secure multi-party computation",
      "text": "How current MPC protocols behave in concrete scenarios, with a focus on the trade-offs between performance and security."
    },
    {
      "name": "Applied cryptography for blockchain and connected vehicles",
      "text": "Security problems in blockchain and connected-car settings, and new solutions for privacy, authentication and confidentiality."
    },
    {
      "name": "Digital identity",
      "text": "Requirements for interoperable identity schemes, including self-sovereign identity, blockchain-based solutions and wearable devices as identity enablers."
    },
    {
      "name": "Authentication, authorization and delegation",
      "text": "Design and implementation of privacy-friendly authentication and access delegation, including proxy re-encryption."
    }
